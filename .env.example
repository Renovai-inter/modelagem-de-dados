# =============================================================================
# RENOVAÍ — CONFIGURAÇÃO DO AMBIENTE (MODELAGEM DE DADOS)
# Copie ou renomeie este arquivo para .env na raiz do repositório:
#   cp .env.example .env
# =============================================================================

# Conexão com o Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=renovai
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_SSLMODE=prefer

# Chave secreta para geração de tokens JWT de teste (mocks)
JWT_SECRET=renovai-secret-key-para-testes-locais
